    "/time-entries": {
      "get": {
        "description": "Sorted by date descending, within a day by creation. Filters combine with AND.",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "example": "2026-11-09",
              "format": "date",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "example": "2026-11-09",
              "format": "date",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TimeEntry",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Time entries",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid filter",
          },
        },
        "summary": "List time entries",
      },
      "post": {
        "description": "A running time entry only comes from the timer.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "date": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "description": {
                    "maxLength": 2000,
                    "type": "string",
                  },
                  "durationSeconds": {
                    "example": 5400,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "projectId": {
                    "exclusiveMinimum": 0,
                    "type": "integer",
                  },
                },
                "required": [
                  "projectId",
                  "date",
                  "durationSeconds",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeEntry",
                },
              },
            },
            "description": "The created time entry",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input",
          },
        },
        "summary": "Create a stopped time entry",
      },
    },
    "/time-entries/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": 1,
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Deleted",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "not_found",
          },
        },
        "summary": "Delete a time entry",
      },
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": 1,
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "date": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "description": {
                    "maxLength": 2000,
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "durationSeconds": {
                    "description": "On a running entry this sets the displayed total duration",
                    "example": 5400,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "hourlyRateMinor": {
                    "description": "Marks the entry as corrected by hand",
                    "example": 9000,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "projectId": {
                    "description": "Takes over the rate of the new project unless hourlyRateMinor is sent along",
                    "exclusiveMinimum": 0,
                    "type": "integer",
                  },
                },
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeEntry",
                },
              },
            },
            "description": "The changed time entry",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "not_found",
          },
        },
        "summary": "Change a time entry",
      },
    },
    "/timer": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TimeEntry",
                    },
                    {
                      "type": [
                        "object",
                        "null",
                      ],
                    },
                  ],
                },
              },
            },
            "description": "The running time entry or null",
          },
        },
        "summary": "The running time entry or null",
      },
    },
    "/timer/start": {
      "post": {
        "description": "Stops the running timer in the same transaction and returns it as \`stopped\`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "Moment of the click; the server takes min(at, server time)",
                        "example": "2026-11-09T17:30:00+01:00",
                        "format": "date-time",
                        "type": "string",
                      },
                      "description": {
                        "maxLength": 2000,
                        "type": "string",
                      },
                      "projectId": {
                        "exclusiveMinimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "projectId",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "at": {
                        "description": "Moment of the click; the server takes min(at, server time)",
                        "example": "2026-11-09T17:30:00+01:00",
                        "format": "date-time",
                        "type": "string",
                      },
                      "timeEntryId": {
                        "description": "Time entry of today",
                        "exclusiveMinimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "timeEntryId",
                    ],
                    "type": "object",
                  },
                ],
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "started": {
                      "$ref": "#/components/schemas/TimeEntry",
                    },
                    "stopped": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/TimeEntry",
                        },
                        {
                          "type": [
                            "object",
                            "null",
                          ],
                        },
                      ],
                    },
                  },
                  "required": [
                    "started",
                    "stopped",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Started and stopped time entry",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input, not a time entry of today, or at before the running start",
          },
        },
        "summary": "Start a new timer or continue a time entry of today",
      },
    },
    "/timer/stop": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "at": {
                    "description": "Moment of the click; the server takes min(at, server time)",
                    "example": "2026-11-09T17:30:00+01:00",
                    "format": "date-time",
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "required": false,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeEntry",
                },
              },
            },
            "description": "The stopped time entry",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input or at before the running start",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "no_running_timer",
          },
        },
        "summary": "Stop the running timer",
      },
    },
  },
  "security": [
    {
      "Bearer": [],
    },
    {
      "Session": [],
    },
  ],
  "servers": [
    {
      "url": "/api/v1",
    },
  ],
  "webhooks": {},
}
`;
