    "/reports": {
      "get": {
        "description": "Archived customers and projects are included, a running timer counts until now. Amount per time entry = round(hourlyRateMinor × rounded seconds / 3600); sums add these.",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "example": "2026-11-09",
              "format": "date",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "example": "2026-11-09",
              "format": "date",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          {
            "description": "csv returns the same filters as CSV; \`Accept: text/csv\` does the same",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "description": "csv returns the same filters as CSV; \`Accept: text/csv\` does the same",
              "enum": [
                "json",
                "csv",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report",
                },
              },
              "text/csv": {
                "schema": {
                  "description": "One row per time entry and expense",
                  "type": "string",
                },
              },
            },
            "description": "The report",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid filter",
          },
        },
        "summary": "Report for a period, grouped by customer and project",
      },
    },
    "/settings": {
