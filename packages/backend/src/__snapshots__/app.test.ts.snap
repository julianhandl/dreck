    "/invoices": {
      "get": {
        "description": "With items and totals, sorted by issue date descending.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Invoice",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Invoices",
          },
        },
        "summary": "List invoices",
      },
      "post": {
        "description": "With \`import\` the uninvoiced Time Entries and Billable Expenses of the Customer become items; they are locked while their item exists.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "customerId": {
                    "exclusiveMinimum": 0,
                    "type": "integer",
                  },
                  "discountBasisPoints": {
                    "example": 2000,
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "dueDate": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "import": {
                    "description": "Turns the uninvoiced, stopped Time Entries (and Billable Expenses) of the Customer in the range into items. They stay locked while their item exists.",
                    "properties": {
                      "expenses": {
                        "description": "Also one item per Billable Expense",
                        "type": "boolean",
                      },
                      "from": {
                        "example": "2026-11-09",
                        "format": "date",
                        "type": "string",
                      },
                      "grouping": {
                        "description": "One item per Project and Hourly Rate, additionally per description, or one per Time Entry",
                        "enum": [
                          "project",
                          "description",
                          "timeEntry",
                        ],
                        "type": "string",
                      },
                      "projectId": {
                        "description": "Only this Project of the Customer",
                        "exclusiveMinimum": 0,
                        "type": "integer",
                      },
                      "to": {
                        "example": "2026-11-09",
                        "format": "date",
                        "type": "string",
                      },
                    },
                    "required": [
                      "from",
                      "to",
                      "grouping",
                      "expenses",
                    ],
                    "type": "object",
                  },
                  "issueDate": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "items": {
                    "items": {
                      "properties": {
                        "description": {
                          "maxLength": 2000,
                          "minLength": 1,
                          "type": "string",
                        },
                        "quantityHundredths": {
                          "description": "Quantity × 100, e.g. 1917 = 19.17 hours",
                          "example": 1917,
                          "maximum": 100000000,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "unitPriceMinor": {
                          "example": 9000,
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "description",
                        "quantityHundredths",
                        "unitPriceMinor",
                      ],
                      "type": "object",
                    },
                    "maxItems": 1000,
                    "type": "array",
                  },
                  "notes": {
                    "description": "Defaults to the default invoice notes",
                    "maxLength": 5000,
                    "type": "string",
                  },
                  "number": {
                    "description": "Defaults to the next number",
                    "example": "RE-2026-001",
                    "maxLength": 50,
                    "minLength": 1,
                    "type": "string",
                  },
                  "periodFrom": {
                    "description": "Defaults to import.from",
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "periodTo": {
                    "description": "Defaults to import.to",
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "recipient": {
                    "description": "Defaults to name and address of the Customer",
                    "maxLength": 5000,
                    "minLength": 1,
                    "type": "string",
                  },
                  "subject": {
                    "maxLength": 5000,
                    "type": "string",
                  },
                  "taxBasisPoints": {
                    "description": "Defaults to the default tax",
                    "example": 2000,
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "integer",
                  },
                },
                "required": [
                  "customerId",
                  "issueDate",
                  "dueDate",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice",
                },
              },
            },
            "description": "The created invoice",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "number_taken",
          },
        },
        "summary": "Create a draft invoice",
      },
    },
    "/invoices/{id}": {
      "delete": {
        "description": "Releases its Time Entries and Expenses.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": 1,
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Deleted",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "not_found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "invoice_locked",
          },
        },
        "summary": "Delete a draft invoice",
      },
      "patch": {
        "description": "Content changes only while it is a draft or in the same call that sets \`sentOn\` and \`paidOn\` to null (409 invoice_locked).",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": 1,
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "discountBasisPoints": {
                    "example": 2000,
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "dueDate": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "issueDate": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": "string",
                  },
                  "items": {
                    "description": "The complete list. Existing items missing here are removed and release their Time Entries and Expenses.",
                    "items": {
                      "properties": {
                        "description": {
                          "maxLength": 2000,
                          "minLength": 1,
                          "type": "string",
                        },
                        "id": {
                          "description": "Existing item to keep; without a new one",
                          "exclusiveMinimum": 0,
                          "type": "integer",
                        },
                        "quantityHundredths": {
                          "description": "Quantity × 100, e.g. 1917 = 19.17 hours",
                          "example": 1917,
                          "maximum": 100000000,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "unitPriceMinor": {
                          "example": 9000,
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "description",
                        "quantityHundredths",
                        "unitPriceMinor",
                      ],
                      "type": "object",
                    },
                    "maxItems": 1000,
                    "type": "array",
                  },
                  "notes": {
                    "maxLength": 5000,
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "number": {
                    "example": "RE-2026-001",
                    "maxLength": 50,
                    "minLength": 1,
                    "type": "string",
                  },
                  "paidOn": {
                    "description": "Set = paid; locks the content",
                    "example": "2026-11-09",
                    "format": "date",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "periodFrom": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "periodTo": {
                    "example": "2026-11-09",
                    "format": "date",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "recipient": {
                    "maxLength": 5000,
                    "minLength": 1,
                    "type": "string",
                  },
                  "sentOn": {
                    "description": "Set = sent; locks the content",
                    "example": "2026-11-09",
                    "format": "date",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "subject": {
                    "maxLength": 5000,
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "taxBasisPoints": {
                    "example": 2000,
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "integer",
                  },
                },
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice",
                },
              },
            },
            "description": "The changed invoice",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "Invalid input",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "not_found",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error",
                },
              },
            },
            "description": "invoice_locked or number_taken",
          },
        },
        "summary": "Change an invoice",
      },
    },
